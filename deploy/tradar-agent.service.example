[Unit]
Description=Tradar Agent HTTP service (example)
After=network.target

[Service]
Type=simple
User=tradar-agent
WorkingDirectory=/opt/tradar-quant-agent
ExecStart=/opt/tradar-quant-agent/.venv/bin/uvicorn agent.http:app --host 127.0.0.1 --port 8891 --workers 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
